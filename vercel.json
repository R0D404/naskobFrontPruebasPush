{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/maps/(.*)",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Range" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://naskob.duckdns.org/v1/:path*"
    },
    {
      "source": "/v1/(.*)",
      "destination": "https://naskob.duckdns.org/v1/$1"
    },
    {
      "source": "/maps/(.*)",
      "destination": "/maps/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
